<!DOCTYPE RCC><RCC version="1.0">
<qresource prefix="/">
    <!-- Theme -->
    <file alias="qml/theme/Theme.qml">qml/theme/Theme.qml</file>
    <!-- Components -->
    <file alias="qml/components/AppTextField.qml">qml/components/AppTextField.qml</file>
    <file alias="qml/components/KpiCardV2.qml">qml/components/KpiCardV2.qml</file>
    <file alias="qml/components/DashboardPanel.qml">qml/components/DashboardPanel.qml</file>
    <!-- Design -->
    <file alias="qml/design/DashboardV2.qml">qml/design/DashboardV2.qml</file>
    <file alias="qml/design/DashboardSidebarV2.qml">qml/design/DashboardSidebarV2.qml</file>
    <!-- Fonts -->
    <file alias="fonts/Poppins-Regular.ttf">resources/fonts/Poppins-Regular.ttf</file>
    <file alias="fonts/Poppins-Medium.ttf">resources/fonts/Poppins-Medium.ttf</file>
    <file alias="fonts/Poppins-SemiBold.ttf">resources/fonts/Poppins-SemiBold.ttf</file>
    <file alias="fonts/Poppins-Bold.ttf">resources/fonts/Poppins-Bold.ttf</file>
    <!-- SVG icons used -->
    <file alias="icons/svg/dashboard.svg">resources/icons/svg/dashboard.svg</file>
    <file alias="icons/svg/families.svg">resources/icons/svg/families.svg</file>
    <file alias="icons/svg/members.svg">resources/icons/svg/members.svg</file>
    <file alias="icons/svg/marriage.svg">resources/icons/svg/marriage.svg</file>
    <file alias="icons/svg/donations.svg">resources/icons/svg/donations.svg</file>
    <file alias="icons/svg/token.svg">resources/icons/svg/token.svg</file>
    <file alias="icons/svg/certificates.svg">resources/icons/svg/certificates.svg</file>
    <file alias="icons/svg/reports.svg">resources/icons/svg/reports.svg</file>
    <file alias="icons/svg/settings.svg">resources/icons/svg/settings.svg</file>
    <file alias="icons/svg/bell.svg">resources/icons/svg/bell.svg</file>
    <file alias="icons/svg/search.svg">resources/icons/svg/search.svg</file>
    <file alias="icons/svg/log-out.svg">resources/icons/svg/log-out.svg</file>
    <file alias="icons/svg/trending-up.svg">resources/icons/svg/trending-up.svg</file>
    <file alias="icons/svg/trending-down.svg">resources/icons/svg/trending-down.svg</file>
</qresource>
</RCC>
