/* ================================================================
   MMS · Emerald Flat theme — LIGHT
   Fonts: Poppins (English) + Gayathri (Malayalam)
   Buttons: squircle, no border, pastel colors
   Sidebar: Islamic star pattern overlay
   ================================================================ */

/* ---------- base ---------- */
QWidget {
    font-family: "Poppins";
    font-size: 10pt;
    color: #12241b;
}
QMainWindow, QDialog { background: #e7f4ea; }
QFrame#contentArea, QWidget#contentArea { background: #e7f4ea; }

/* ---------- typography roles ---------- */
QLabel[cssClass="display"]   { font-family: "Space Grotesk"; font-weight: 700; }
QLabel[cssClass="h1"]        { font-family: "Space Grotesk"; font-size: 15pt; font-weight: 700; color: #12241b; }
QLabel[cssClass="h2"]        { font-family: "Space Grotesk"; font-size: 12pt; font-weight: 700; color: #12241b; }
QLabel[cssClass="statValue"] { font-family: "Space Grotesk"; font-size: 18pt; font-weight: 700; color: #04543c; max-height: 30px; background: transparent; }
QLabel[cssClass="statLabel"] { font-size: 8pt; font-weight: 800; letter-spacing: 1px; color: #04543c; max-height: 16px; background: transparent; }
QLabel[cssClass="viewSub"]   { font-size: 9pt; font-weight: 600; color: #4f6b5c; background: transparent; }
QLabel[cssClass="muted"]     { color: #4f6b5c; }
QLabel[cssClass="faint"]     { color: #7e968a; }
QLabel[cssClass="emerald"]   { color: #047857; font-weight: 700; }
QLabel[cssClass="sectionTitle"] { font-size: 8pt; font-weight: 800; letter-spacing: 2px; color: #7e968a; }
QLabel[cssClass="ml"]        { font-family: "Gayathri"; }
QLabel[cssClass="crumbSmall"] { font: 700 8.5pt Poppins; color: #7e968a; letter-spacing: 0.5px; text-transform: uppercase; }
QLabel[cssClass="crumbBig"]   { font: 700 11.5pt "Space Grotesk"; color: #12241b; }

/* ---------- sidebar with Islamic star pattern ---------- */
QFrame#sidebar, QWidget#sidebar {
    background-color: #065f46;
    background-image: url(:/resources/icons/pattern-star.svg);
    background-repeat: repeat-xy;
    background-position: top left;
}
QLabel[cssClass="logoTitle"] { color: #ffffff; font-family: "Space Grotesk"; font-size: 13pt; font-weight: 800; }
QLabel[cssClass="logoSub"]   { color: #a5dcc6; font-size: 8pt; font-weight: 600; letter-spacing: 1px; }
QLabel[cssClass="navSection"]{ color: rgba(214,240,228,0.42); font-size: 7pt; font-weight: 800; letter-spacing: 2px; padding: 15px 24px 5px; }
QListWidget#sidebarNav { background: transparent; border: none; outline: none; }
QListWidget#sidebarNav::item {
    color: #c4e7d7; padding: 11px 13px; margin: 2px 10px; border-radius: 9px;
    border-left: 4px solid transparent; font-weight: 700; font-size: 9.8pt;
}
QListWidget#sidebarNav::item:hover { background: rgba(255,255,255,0.09); color: #ffffff; }
QListWidget#sidebarNav::item:selected {
    background: rgba(255,255,255,0.14); color: #ffffff;
    border-left: 4px solid #f2c14e;
}
QFrame#userCard { background: transparent; border-top: 1px solid rgba(255,255,255,0.14); }
QFrame#userCard QLabel[cssClass="userName"] { color: #ffffff; font-weight: 700; font-size: 9.5pt; }
QFrame#userCard QLabel[cssClass="userRole"] { color: #9fd8c3; font-size: 8pt; font-weight: 600; }
QLabel[cssClass="avatar"] {
    background: #f2c14e; color: #4a3606; border-radius: 9px;
    border: 2px solid #b98317;
    font-family: "Space Grotesk"; font-weight: 800; font-size: 10pt;
    qproperty-alignment: AlignCenter;
}
QToolButton#flap, QPushButton[cssClass="flap"] {
    background: #047857; border: 1px solid #0a7f5d; border-radius: 9px;
    color: #ffffff; padding: 0px; margin: 0px;
}
QToolButton#flap:hover, QPushButton[cssClass="flap"]:hover { background: #0aa06f; color: #ffffff; }

/* ---------- top bar ---------- */
QFrame#topBar { background: #ffffff; border-bottom: 1.5px solid #d2e5d8; min-height: 54px; max-height: 58px; }
QLineEdit#searchBox {
    background: #f2faf4; border: 1.5px solid #d2e5d8; border-radius: 9px;
    padding: 8px 12px; color: #12241b; min-height: 36px; max-width: 330px;
    selection-background-color: #dff5e7; selection-color: #065f46;
}
QLineEdit#searchBox:focus { border: 2px solid #059669; padding: 7px 11px; }

/* ---------- cards ---------- */
QFrame[cssClass="card"], QFrame#card, QFrame[objectName="card"] {
    background: #ffffff; border: 1.5px solid #d2e5d8; border-radius: 10px;
}
QFrame#statCard {
    border-radius: 10px; min-width: 180px; max-width: 300px;
    min-height: 110px; max-height: 140px;
}
QLabel[cssClass="chartTitle"] { font-weight: 700; font-size: 10pt; color: #12241b; max-height: 20px; background: transparent; }
QLabel[cssClass="chartSub"]   { color: #7e968a; font-size: 8.5pt; font-weight: 600; max-height: 16px; background: transparent; }

/* ---------- buttons: SQUIRCLE, NO BORDER, pastel colors ---------- */
QPushButton {
    background: #ecfdf5; border: none; border-radius: 12px;
    padding: 9px 18px; color: #04543c; font-weight: 700; font-size: 9.8pt;
    min-height: 36px; min-width: 80px;
}
QPushButton:hover   { background: #d3f5e6; }
QPushButton:pressed { background: #a7f3d0; }
QPushButton:disabled { background: #f2faf4; color: #7e968a; }

QPushButton[cssClass="primary"] {
    background: #d3f5e6; border: none; border-radius: 12px; color: #04543c;
}
QPushButton[cssClass="primary"]:hover   { background: #a7f3d0; }
QPushButton[cssClass="primary"]:pressed { background: #6ee7b7; }
QPushButton[cssClass="primary"]:disabled { background: #f2faf4; color: #7e968a; }

QPushButton[cssClass="danger"] {
    background: #fddfe5; border: none; border-radius: 12px; color: #95102e;
}
QPushButton[cssClass="danger"]:hover { background: #fecdd3; }

QPushButton[cssClass="ghostDanger"] {
    background: #fddfe5; border: none; border-radius: 12px; color: #95102e;
}
QPushButton[cssClass="ghostDanger"]:hover { background: #fecdd3; }

QPushButton[cssClass="small"] { padding: 5px 12px; font-size: 8.8pt; border-radius: 10px; min-height: 28px; }

QPushButton[cssClass="icon"] {
    background: transparent; border: none; border-radius: 10px;
    padding: 6px; color: #4f6b5c;
}
QPushButton[cssClass="icon"]:hover { background: #ecfdf5; color: #047857; }

QPushButton[cssClass="chip"] {
    border-radius: 99px; padding: 7px 16px; border: none;
    background: #e6ebf2; color: #33415c; font-weight: 700; font-size: 9pt; min-height: 32px;
}
QPushButton[cssClass="chip"]:hover { background: #d1dae8; }
QPushButton[cssClass="chip"]:checked { background: #059669; color: #ffffff; }

/* QA buttons: pastel backgrounds, squircle, no border */
QPushButton[cssClass="qaBlue"]   { background: #dbe7fd; border: none; border-radius: 12px; color: #1e3fae; }
QPushButton[cssClass="qaPurple"] { background: #e7defc; border: none; border-radius: 12px; color: #5423b7; }
QPushButton[cssClass="qaGreen"]  { background: #d3f5e6; border: none; border-radius: 12px; color: #04543c; }
QPushButton[cssClass="qaOrange"] { background: #fcebc8; border: none; border-radius: 12px; color: #7c4403; }
QPushButton[cssClass="qaIndigo"] { background: #e0e7ff; border: none; border-radius: 12px; color: #3730a3; }
QPushButton[cssClass="qaBlue"]:hover   { background: #c7d8fc; }
QPushButton[cssClass="qaPurple"]:hover { background: #d8ccf9; }
QPushButton[cssClass="qaGreen"]:hover  { background: #b0eccc; }
QPushButton[cssClass="qaOrange"]:hover { background: #f7dfa8; }
QPushButton[cssClass="qaIndigo"]:hover { background: #ccd5f5; }

/* ---------- status pills ---------- */
QLabel[cssClass="pill"] {
    padding: 3px 10px; border-radius: 99px;
    font-size: 8pt; font-weight: 800; letter-spacing: 0.5px;
    qproperty-alignment: AlignCenter;
}
QLabel[status="Paid"], QLabel[status="Active"], QLabel[status="Collected"],
QLabel[status="Disbursed"], QLabel[status="Income"], QLabel[status="Administrator"] {
    background: #d3f5e6; color: #04543c; border: 1.5px solid #059669;
}
QLabel[status="Pending"], QLabel[status="Requested"], QLabel[status="Assigned"] {
    background: #fcebc8; color: #7c4403; border: 1.5px solid #d97706;
}
QLabel[status="Overdue"], QLabel[status="Revoked"], QLabel[status="Expense"] {
    background: #fddfe5; color: #95102e; border: 1.5px solid #e11d48;
}
QLabel[status="Approved"], QLabel[status="Manager"], QLabel[status="Manual"] {
    background: #c9f2fa; color: #115e72; border: 1.5px solid #0891b2;
}
QLabel[status="Available"], QLabel[status="Archived"], QLabel[status="Disabled"],
QLabel[status="User"], QLabel[status="Auto"] {
    background: #e6ebf2; color: #33415c; border: 1.5px solid #64748b;
}

/* ---------- inputs ---------- */
QLineEdit, QSpinBox, QDateEdit, QTimeEdit, QPlainTextEdit, QTextEdit {
    background: #ffffff; border: 1.5px solid #b2cfbd; border-radius: 8px;
    padding: 9px 12px; color: #12241b; selection-background-color: #dff5e7; selection-color: #065f46;
}
QLineEdit:focus, QSpinBox:focus, QDateEdit:focus, QTimeEdit:focus { border: 2px solid #059669; padding: 8px 11px; }
QLabel[cssClass="fieldLabel"] { color: #4f6b5c; font-size: 8pt; font-weight: 800; letter-spacing: 1px; }

QComboBox {
    background: #ffffff; border: 1.5px solid #b2cfbd; border-radius: 8px;
    padding: 9px 12px; color: #12241b; font-weight: 600;
}
QComboBox:focus, QComboBox:on { border: 2px solid #059669; padding: 8px 11px; }
QComboBox::drop-down { border: none; width: 30px; margin: 0; }
QComboBox::down-arrow { image: url(:/resources/icons/chevron-down.svg); width: 12px; height: 12px; margin-right: 10px; }
QComboBox QAbstractItemView {
    background: #ffffff; border: 1.5px solid #d2e5d8; border-radius: 10px;
    margin: 0; padding: 4px; outline: none;
    selection-background-color: #ecfdf5; selection-color: #065f46;
}
QComboBox QAbstractItemView::item { padding: 8px 12px; min-height: 30px; border-radius: 7px; }
QComboBox QAbstractItemView::item:hover { background: #ecfdf5; color: #047857; }
QComboBox QAbstractItemView::item:selected { background: #ecfdf5; color: #065f46; }

QCheckBox { spacing: 9px; color: #12241b; font-weight: 700; font-size: 9.5pt; }
QCheckBox::indicator { width: 17px; height: 17px; border-radius: 5px; border: 1.5px solid #b2cfbd; background: #ffffff; }
QCheckBox::indicator:checked { background: #059669; border-color: #059669; }

/* ---------- tables ---------- */
QTableWidget, QTableView {
    background: #ffffff; alternate-background-color: #ffffff;
    border: 1.5px solid #d2e5d8; border-radius: 10px; gridline-color: transparent;
    selection-background-color: #dff5e7; selection-color: #065f46; font-size: 9.8pt; outline: none;
}
QTableWidget::item, QTableView::item { padding: 8px 12px; border: none; min-height: 28px; }
QHeaderView::section {
    background: #eef8f1; color: #4f6b5c; padding: 8px 12px;
    border: none; border-bottom: 2px solid #d2e5d8;
    font-size: 7.5pt; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; min-height: 32px;
}
QHeaderView::section:hover { color: #047857; }
QTableCornerButton::section { background: #eef8f1; border: none; }

/* ---------- menus ---------- */
QMenu { background: #ffffff; border: 1.5px solid #d2e5d8; border-radius: 11px; padding: 6px; }
QMenu::item { padding: 9px 26px 9px 14px; border-radius: 8px; font-weight: 700; }
QMenu::item:selected { background: #ecfdf5; color: #065f46; }
QMenu::separator { height: 1.5px; background: #d2e5d8; margin: 4px 8px; }

/* ---------- scrollbars ---------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; border: none; }
QScrollBar::handle:vertical { background: #b2cfbd; border-radius: 5px; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: #059669; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; border: none; }
QScrollBar::handle:horizontal { background: #b2cfbd; border-radius: 5px; min-width: 32px; }
QScrollBar::handle:horizontal:hover { background: #059669; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
QListWidget#sidebarNav QScrollBar::handle:vertical { background: rgba(255,255,255,0.22); }
QListWidget#sidebarNav QScrollBar::handle:vertical:hover { background: rgba(255,255,255,0.4); }

/* ---------- tooltip ---------- */
QToolTip {
    background: #0e1f18; color: #e8f6ef; border: 1px solid #1d4636;
    border-left: 4px solid #059669; padding: 7px 11px; border-radius: 8px;
    font-size: 9pt; font-weight: 700;
}

/* ---------- empty state ---------- */
QFrame[cssClass="emptyState"] { background: transparent; }
QLabel[cssClass="emptyIcon"]    { font-size: 32pt; color: #7e968a; background: transparent; }
QLabel[cssClass="emptyTitle"]   { font-size: 12pt; font-weight: 700; color: #4f6b5c; background: transparent; }
QLabel[cssClass="emptySubtitle"]{ font-size: 10pt; color: #7e968a; font-style: italic; background: transparent; }

/* ---------- toast ---------- */
QFrame#toast { background: #ffffff; border: 1px solid #d2e5d8; border-radius: 10px; }
QFrame#toast[kind="ok"]   { border-left: 4px solid #059669; }
QFrame#toast[kind="err"]  { border-left: 4px solid #e11d48; }
QFrame#toast[kind="warn"] { border-left: 4px solid #d97706; }
QFrame#toast[kind="info"] { border-left: 4px solid #0891b2; }
QFrame#toast QLabel#toastMsg { color: #12241b; font-size: 10pt; font-weight: 600; background: transparent; }

/* ---------- progress ---------- */
QProgressBar { background: #f2faf4; border: 1.5px solid #d2e5d8; border-radius: 6px; max-height: 10px; min-height: 10px; text-align: center; color: transparent; }
QProgressBar::chunk { background: #059669; border-radius: 5px; }

/* ---------- status bar ---------- */
QStatusBar { background: #f2faf4; border-top: 1.5px solid #d2e5d8; color: #4f6b5c; font-size: 8.5pt; font-weight: 600; }
QStatusBar QLabel { color: #4f6b5c; font-size: 8.5pt; font-weight: 600; }
QStatusBar::item { border: none; }

/* ---------- group box ---------- */
QGroupBox { border: 1.5px solid #d2e5d8; border-radius: 10px; margin-top: 14px; padding-top: 16px; background: #ffffff; }
QGroupBox::title { subcontrol-origin: margin; left: 14px; padding: 0 6px; color: #4f6b5c; font-weight: 800; font-size: 8.5pt; }

/* ---------- message boxes ---------- */
QMessageBox { background: #ffffff; }
QMessageBox QLabel { color: #12241b; font-size: 10pt; }

/* ---------- delta badges (stat card) ---------- */
QLabel[cssClass="deltaUp"], QLabel[cssClass="deltaDown"] {
    font: 800 9.5px Poppins; padding: 3px 8px; border-radius: 99px;
    background: #ffffff; max-width: 140px;
}
QLabel[cssClass="deltaUp"]   { color: #047857; border: 1.5px solid #059669; }
QLabel[cssClass="deltaDown"] { color: #95102e; border: 1.5px solid #e11d48; }

/* ---------- stat card tint variants ---------- */
QFrame[cssClass="statTint-em"]     { background: #d3f5e6; border: 1.5px solid #059669; border-radius: 10px; }
QFrame[cssClass="statTint-teal"]   { background: #c8f6f1; border: 1.5px solid #0d9488; border-radius: 10px; }
QFrame[cssClass="statTint-sky"]    { background: #d7edfb; border: 1.5px solid #0284c7; border-radius: 10px; }
QFrame[cssClass="statTint-gold"]   { background: #fcebc8; border: 1.5px solid #d97706; border-radius: 10px; }
QFrame[cssClass="statTint-rose"]   { background: #fddfe5; border: 1.5px solid #e11d48; border-radius: 10px; }
QFrame[cssClass="statTint-pink"]   { background: #fadfeb; border: 1.5px solid #db2777; border-radius: 10px; }
QFrame[cssClass="statTint-violet"] { background: #e7defc; border: 1.5px solid #7c3aed; border-radius: 10px; }
QFrame[cssClass="statTint-orange"] { background: #ffe4cf; border: 1.5px solid #ea580c; border-radius: 10px; }
QFrame[cssClass="statTint-slate"]  { background: #e6ebf2; border: 1.5px solid #64748b; border-radius: 10px; }
QFrame[cssClass="statTint-blue"]   { background: #dbe7fd; border: 1.5px solid #2563eb; border-radius: 10px; }

/* stat card value/label per tint */
QLabel[cssClass="statVal-em"]     { font: 700 18pt "Space Grotesk"; color: #04543c; background: transparent; max-height: 30px; }
QLabel[cssClass="statVal-teal"]   { font: 700 18pt "Space Grotesk"; color: #0f5e54; background: transparent; max-height: 30px; }
QLabel[cssClass="statVal-sky"]    { font: 700 18pt "Space Grotesk"; color: #0a5480; background: transparent; max-height: 30px; }
QLabel[cssClass="statVal-gold"]   { font: 700 18pt "Space Grotesk"; color: #7c4403; background: transparent; max-height: 30px; }
QLabel[cssClass="statVal-rose"]   { font: 700 18pt "Space Grotesk"; color: #95102e; background: transparent; max-height: 30px; }
QLabel[cssClass="statVal-pink"]   { font: 700 18pt "Space Grotesk"; color: #93184f; background: transparent; max-height: 30px; }
QLabel[cssClass="statVal-violet"] { font: 700 18pt "Space Grotesk"; color: #5423b7; background: transparent; max-height: 30px; }
QLabel[cssClass="statVal-orange"] { font: 700 18pt "Space Grotesk"; color: #8f3708; background: transparent; max-height: 30px; }
QLabel[cssClass="statVal-slate"]  { font: 700 18pt "Space Grotesk"; color: #33415c; background: transparent; max-height: 30px; }
QLabel[cssClass="statVal-blue"]   { font: 700 18pt "Space Grotesk"; color: #1e3fae; background: transparent; max-height: 30px; }

QLabel[cssClass="statLab-em"]     { font: 800 8pt Poppins; letter-spacing: 1px; color: #04543c; background: transparent; max-height: 16px; }
QLabel[cssClass="statLab-teal"]   { font: 800 8pt Poppins; letter-spacing: 1px; color: #0f5e54; background: transparent; max-height: 16px; }
QLabel[cssClass="statLab-sky"]    { font: 800 8pt Poppins; letter-spacing: 1px; color: #0a5480; background: transparent; max-height: 16px; }
QLabel[cssClass="statLab-gold"]   { font: 800 8pt Poppins; letter-spacing: 1px; color: #7c4403; background: transparent; max-height: 16px; }
QLabel[cssClass="statLab-rose"]   { font: 800 8pt Poppins; letter-spacing: 1px; color: #95102e; background: transparent; max-height: 16px; }
QLabel[cssClass="statLab-pink"]   { font: 800 8pt Poppins; letter-spacing: 1px; color: #93184f; background: transparent; max-height: 16px; }
QLabel[cssClass="statLab-violet"] { font: 800 8pt Poppins; letter-spacing: 1px; color: #5423b7; background: transparent; max-height: 16px; }
QLabel[cssClass="statLab-orange"] { font: 800 8pt Poppins; letter-spacing: 1px; color: #8f3708; background: transparent; max-height: 16px; }
QLabel[cssClass="statLab-slate"]  { font: 800 8pt Poppins; letter-spacing: 1px; color: #33415c; background: transparent; max-height: 16px; }
QLabel[cssClass="statLab-blue"]   { font: 800 8pt Poppins; letter-spacing: 1px; color: #1e3fae; background: transparent; max-height: 16px; }

/* chart title with colored left border */
QLabel[cssClass="chartTitle-em"]     { font: 700 10pt Poppins; color: #12241b; background: transparent; padding-left: 10px; border-left: 5px solid #059669; max-height: 20px; }
QLabel[cssClass="chartTitle-gold"]   { font: 700 10pt Poppins; color: #12241b; background: transparent; padding-left: 10px; border-left: 5px solid #d97706; max-height: 20px; }
QLabel[cssClass="chartTitle-violet"] { font: 700 10pt Poppins; color: #12241b; background: transparent; padding-left: 10px; border-left: 5px solid #7c3aed; max-height: 20px; }
QLabel[cssClass="chartTitle-sky"]    { font: 700 10pt Poppins; color: #12241b; background: transparent; padding-left: 10px; border-left: 5px solid #0284c7; max-height: 20px; }

/* QA button text labels */
QLabel[cssClass="qaTitle"] { font: 700 11px Poppins; color: #12241b; background: transparent; border: none; max-height: 16px; }
QLabel[cssClass="qaSub"]   { font: 600 9px Poppins; color: #7e968a; background: transparent; border: none; max-height: 14px; }

/* date chip */
QLabel[cssClass="dateChip"] { font: 700 9pt Poppins; color: #33415c; background: #e6ebf2; border: 1.5px solid #64748b; border-radius: 7px; padding: 7px 12px; }
