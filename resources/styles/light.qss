/* ---------- base ---------- */
QWidget {
    font-family: "Manrope";
    font-size: 10pt;
    color: #0f172a;
}
QMainWindow, QDialog { background: #edf1f6; }
QFrame#contentArea { background: #edf1f6; }

/* ---------- typography roles ---------- */
QLabel[cssClass="display"]   { font-family: "Space Grotesk"; font-weight: 700; }
QLabel[cssClass="h1"]        { font-family: "Space Grotesk"; font-size: 15pt; font-weight: 700; color: #0f172a; }
QLabel[cssClass="h2"]        { font-family: "Space Grotesk"; font-size: 12pt; font-weight: 700; color: #0f172a; }
QLabel[cssClass="statValue"] { font-family: "Space Grotesk"; font-size: 17pt; font-weight: 700; color: #0f172a; }
QLabel[cssClass="statLabel"] { font-size: 8pt; font-weight: 800; letter-spacing: 1px; color: #5b6779; }
QLabel[cssClass="viewSub"]   { font-size: 9.5pt; font-weight: 600; color: #5b6779; }
QLabel[cssClass="muted"]     { color: #5b6779; }
QLabel[cssClass="faint"]     { color: #8b96a8; }
QLabel[cssClass="emerald"]   { color: #047857; font-weight: 700; }
QLabel[cssClass="sectionTitle"] { font-size: 8pt; font-weight: 800; letter-spacing: 2px; color: #8b96a8; }
QLabel[cssClass="ml"]        { font-family: "Anek Malayalam"; }

/* ---------- custom title bar ---------- */
QFrame#titleBar { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0a4a38, stop:1 #053527); }
QFrame#titleBar QLabel { color: #cfeee0; font-weight: 600; font-size: 9pt; }
QFrame#titleBar QLabel[cssClass="appTitle"] { color: #ffffff; font-family: "Space Grotesk"; font-weight: 700; }

/* ---------- splash ---------- */
QWidget#splashFrame, QFrame#splashFrame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #065f46, stop:0.52 #059669, stop:1 #065f46);
}
QLabel[cssClass="splashTitle"] { color: #ffffff; font-family: "Space Grotesk"; font-size: 20pt; font-weight: 700; }
QLabel[cssClass="splashMl"]    { color: #c9ecd9; font-family: "Anek Malayalam"; font-size: 11pt; font-weight: 600; }
QLabel[cssClass="splashMsg"]   { color: #d7f2e4; font-size: 9pt; font-weight: 600; }
QLabel[cssClass="splashTech"]  { color: rgba(255,255,255,0.5); font-size: 7.5pt; font-weight: 600; letter-spacing: 3px; }
QProgressBar {
    background: rgba(0,0,0,0.28);
    border: none; border-radius: 4px;
    max-height: 8px; min-height: 8px;
    text-align: center; color: transparent; font-size: 1pt;
}
QProgressBar::chunk {
    border-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #b98317, stop:0.35 #f2c14e, stop:0.5 #ffe9a8, stop:0.65 #f2c14e, stop:1 #b98317);
}
QProgressBar[cssClass="emerald"]::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #059669, stop:1 #34d399); }

/* ---------- login ---------- */
QWidget#loginLeft {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #04463a, stop:0.4 #065f46, stop:1 #059669);
}
QWidget#loginLeft QLabel { color: #ffffff; }
QWidget#loginLeft QLabel[cssClass="loginMl"]  { color: #bfe8d4; font-family: "Anek Malayalam"; font-size: 12.5pt; }
QWidget#loginLeft QLabel[cssClass="loginBody"]{ color: #cfeade; font-size: 10pt; }
QWidget#loginRight { background: #f6f8fb; }
QFrame#loginCard { background: #ffffff; border: 1px solid #e3e8ef; border-radius: 14px; }
QLabel[cssClass="loginHintCode"] {
    background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0;
    border-radius: 6px; padding: 2px 8px;
    font-family: "Space Grotesk"; font-weight: 700; font-size: 8.5pt;
}
QLabel[cssClass="errorBox"] {
    background: #fff1f3; color: #e11d48; border: 1px solid #fecdd3;
    border-radius: 8px; padding: 8px 11px; font-weight: 600; font-size: 9pt;
}

/* ---------- sidebar ---------- */
QFrame#sidebar, QWidget#sidebar {
    background-color: #065f46;
    background-image: url(:/resources/icons/pattern-star.svg);
    background-repeat: repeat-x;
    border-right: 1px solid rgba(0,0,0,0.25);
}
QLabel[cssClass="logoTitle"] { color: #ffffff; font-family: "Space Grotesk"; font-size: 13pt; font-weight: 800; }
QLabel[cssClass="logoSub"]   { color: #a5dcc6; font-size: 8pt; font-weight: 600; letter-spacing: 1px; }
QLabel[cssClass="navSection"]{
    color: rgba(214,240,228,0.42);
    font-size: 7pt; font-weight: 800; letter-spacing: 2px;
    padding: 15px 24px 5px 24px;
}
QListWidget#sidebarNav { background: transparent; border: none; outline: none; }
QListWidget#sidebarNav::item {
    color: #c4e7d7;
    padding: 11px 13px;
    margin: 2px 10px;
    border-radius: 9px;
    border-left: 3px solid transparent;
    font-weight: 700; font-size: 9.8pt;
}
QListWidget#sidebarNav::item:hover { background: rgba(255,255,255,0.09); color: #ffffff; }
QListWidget#sidebarNav::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(255,255,255,0.16), stop:1 rgba(255,255,255,0.05));
    color: #ffffff;
    border-left: 3px solid #f2c14e;
}
QFrame#userCard { background: transparent; border-top: 1px solid rgba(255,255,255,0.14); }
QFrame#userCard QLabel[cssClass="userName"] { color: #ffffff; font-weight: 700; font-size: 9.5pt; }
QFrame#userCard QLabel[cssClass="userRole"] { color: #9fd8c3; font-size: 8pt; font-weight: 600; }
QLabel[cssClass="avatar"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ffe9a8, stop:1 #f2c14e);
    color: #04463a; border-radius: 10px;
    font-family: "Space Grotesk"; font-weight: 800; font-size: 10pt;
    qproperty-alignment: AlignCenter;
}
QPushButton[cssClass="flap"], QToolButton#flap {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0a8a63, stop:1 #047857);
    border: 1px solid rgba(255,255,255,0.22);
    border-radius: 9px;
    color: #ffffff;
    padding: 0px;
    margin: 0px;
}
QPushButton[cssClass="flap"]:hover, QToolButton#flap:hover {
    background: #0aa06f; color: #ffffff;
}

/* ---------- top bar ---------- */
QFrame#topBar { background: #ffffff; border-bottom: 1px solid #e3e8ef; }
QLabel[cssClass="crumbSmall"] { color: #8b96a8; font-size: 8.5pt; font-weight: 600; letter-spacing: 1px; }
QLabel[cssClass="crumbBig"]   { color: #0f172a; font-family: "Space Grotesk"; font-size: 11.5pt; font-weight: 700; }
QLineEdit#searchBox {
    background: #f6f8fb; border: 1.5px solid #e3e8ef; border-radius: 10px;
    padding: 8px 12px; color: #0f172a;
}
QLineEdit#searchBox:focus { border: 2px solid #059669; padding: 7px 11px; }
QFrame[cssClass="sessionChip"] { background: #f6f8fb; border: 1px solid #e3e8ef; border-radius: 12px; }
QFrame[cssClass="sessionChip"] QLabel { color: #5b6779; font-family: "Space Grotesk"; font-weight: 700; font-size: 8.5pt; }

/* ---------- cards ---------- */
QFrame[cssClass="card"], QFrame#card, QFrame[objectName="card"], QFrame[objectName="statCard"] {
    background: #ffffff;
    border: 1px solid #e3e8ef;
    border-radius: 12px;
}
QFrame[cssClass="statCard"]:hover { border-color: #a7f3d0; }
QFrame[cssClass="cardHover"]:hover { border-color: #059669; }
QLabel[cssClass="chartTitle"] { font-weight: 700; font-size: 10pt; }
QLabel[cssClass="chartSub"]   { color: #8b96a8; font-size: 8.5pt; font-weight: 600; }

/* icon tint chips */
QLabel[cssClass="tint-em"]     { background: #ecfdf5; color: #059669; border-radius: 10px; qproperty-alignment: AlignCenter; }
QLabel[cssClass="tint-teal"]   { background: #f0fdfa; color: #0d9488; border-radius: 10px; qproperty-alignment: AlignCenter; }
QLabel[cssClass="tint-cyan"]   { background: #f0f9ff; color: #0284c7; border-radius: 10px; qproperty-alignment: AlignCenter; }
QLabel[cssClass="tint-gold"]   { background: #fdf6e3; color: #c8941a; border-radius: 10px; qproperty-alignment: AlignCenter; }
QLabel[cssClass="tint-rose"]   { background: #fff1f3; color: #e11d48; border-radius: 10px; qproperty-alignment: AlignCenter; }
QLabel[cssClass="tint-violet"] { background: #f5f3ff; color: #7c3aed; border-radius: 10px; qproperty-alignment: AlignCenter; }
QLabel[cssClass="tint-slate"]  { background: #f1f5f9; color: #64748b; border-radius: 10px; qproperty-alignment: AlignCenter; }

/* ---------- status pills (QLabel with property "status") ---------- */
QLabel[cssClass="pill"] {
    padding: 3px 10px; border-radius: 9px;
    font-size: 8pt; font-weight: 800; letter-spacing: 0.5px;
    qproperty-alignment: AlignCenter;
}
QLabel[status="Paid"], QLabel[status="Active"], QLabel[status="Collected"],
QLabel[status="Disbursed"], QLabel[status="Income"], QLabel[status="Administrator"] {
    background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0;
}
QLabel[status="Pending"], QLabel[status="Requested"], QLabel[status="Assigned"] {
    background: #fffbeb; color: #b45309; border: 1px solid #fde68a;
}
QLabel[status="Overdue"], QLabel[status="Revoked"], QLabel[status="Expense"] {
    background: #fff1f3; color: #be123c; border: 1px solid #fecdd3;
}
QLabel[status="Approved"], QLabel[status="Manager"], QLabel[status="Manual"] {
    background: #f0f9ff; color: #0369a1; border: 1px solid #bae6fd;
}
QLabel[status="Available"], QLabel[status="Archived"], QLabel[status="Disabled"],
QLabel[status="User"], QLabel[status="Auto"] {
    background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0;
}
QLabel[status="Building"] { background: #fdf6e3; color: #92600a; border: 1px solid #f0dfa8; }
QLabel[status="Education"] { background: #f0f9ff; color: #0369a1; border: 1px solid #bae6fd; }
QLabel[status="Medical"]   { background: #f5f3ff; color: #6d28d9; border: 1px solid #ddd6fe; }
QLabel[status="Masjid"]    { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
QLabel[status="General"]   { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }

/* ---------- buttons ---------- */
QPushButton {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 9px;
    padding: 8px 15px;
    color: #0f172a;
    font-weight: 700; font-size: 9.8pt;
}
QPushButton:hover   { border-color: #059669; color: #047857; background: #ecfdf5; }
QPushButton:pressed { background: #d1fae5; }
QPushButton:disabled { background: #f6f8fb; color: #8b96a8; border-color: #e3e8ef; }

QPushButton[cssClass="primary"] {
    background: #059669; border: 1px solid #047857; color: #ffffff;
}
QPushButton[cssClass="primary"]:hover   { background: #047857; color: #ffffff; }
QPushButton[cssClass="primary"]:pressed { background: #065f46; }
QPushButton[cssClass="primary"]:disabled { background: #a7f3d0; border-color: #a7f3d0; color: #ecfdf5; }

QPushButton[cssClass="danger"] { background: #e11d48; border-color: #be123c; color: #ffffff; }
QPushButton[cssClass="danger"]:hover { background: #be123c; color: #ffffff; }
QPushButton[cssClass="danger"]:pressed { background: #9f1239; }

QPushButton[cssClass="ghostDanger"] { background: transparent; border-color: #fecdd3; color: #e11d48; }
QPushButton[cssClass="ghostDanger"]:hover { background: #fff1f3; color: #e11d48; }

QPushButton[cssClass="small"] { padding: 5px 10px; font-size: 8.8pt; border-radius: 7px; }

QPushButton[cssClass="icon"] {
    background: transparent; border: 1px solid transparent;
    border-radius: 8px; padding: 6px; color: #5b6779;
}
QPushButton[cssClass="icon"]:hover { background: #ecfdf5; border-color: #a7f3d0; color: #047857; }
QPushButton[cssClass="iconDanger"]:hover { background: #fff1f3; border-color: #fecdd3; color: #e11d48; }

QPushButton[cssClass="chip"] {
    border-radius: 12px; padding: 7px 14px;
    border: 1px solid #cbd5e1; background: #ffffff;
    color: #5b6779; font-weight: 700; font-size: 9pt;
}
QPushButton[cssClass="chip"]:hover { border-color: #059669; color: #047857; }
QPushButton[cssClass="chip"]:checked { background: #059669; border-color: #059669; color: #ffffff; }

QPushButton[cssClass="exportTag"] {
    background: #f6f8fb; border: 1px solid #cbd5e1; border-radius: 6px;
    padding: 4px 9px; color: #5b6779;
    font-family: "Space Grotesk"; font-weight: 700; font-size: 7.5pt; letter-spacing: 1px;
}
QPushButton[cssClass="exportTag"]:hover { background: #ecfdf5; border-color: #059669; color: #047857; }

/* ---------- inputs ---------- */
QLineEdit, QSpinBox, QDateEdit, QTimeEdit, QPlainTextEdit, QTextEdit {
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 9px;
    padding: 9px 12px;
    selection-background-color: #a7f3d0;
    selection-color: #064e3b;
    color: #0f172a;
}
QLineEdit:focus, QSpinBox:focus, QDateEdit:focus, QTimeEdit:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border: 2px solid #059669;
    padding: 8px 11px;
}
QLineEdit:disabled, QSpinBox:disabled, QDateEdit:disabled {
    background: #f6f8fb; color: #8b96a8;
}
QLabel[cssClass="fieldLabel"] {
    color: #5b6779; font-size: 8pt; font-weight: 800; letter-spacing: 1px;
}
QDateEdit::drop-down, QTimeEdit::drop-down {
    border: none; width: 26px; subcontrol-position: center right;
}
QDateEdit::down-arrow, QTimeEdit::down-arrow {
    image: url(:/resources/icons/chevron-down.svg);
    width: 12px; height: 12px;
}
QSpinBox::up-button, QSpinBox::down-button { width: 18px; border: none; }

/* ---------- combo box (StyledComboBox) ---------- */
QComboBox {
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 9px;
    padding: 9px 12px;
    color: #0f172a;
    font-weight: 600;
}
QComboBox:focus, QComboBox:on { border: 2px solid #059669; padding: 8px 11px; }
QComboBox::drop-down { border: none; width: 30px; margin: 0; }
QComboBox::down-arrow { image: url(:/resources/icons/chevron-down.svg); width: 12px; height: 12px; margin-right: 10px; }
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #e3e8ef;
    border-radius: 10px;
    margin: 0;
    padding: 4px;
    outline: none;
    selection-background-color: #ecfdf5;
    selection-color: #065f46;
}
QComboBox QAbstractItemView::item { padding: 8px 12px; min-height: 30px; border-radius: 7px; }
QComboBox QAbstractItemView::item:hover { background: #ecfdf5; color: #047857; }
QComboBox QAbstractItemView::item:selected { background: #ecfdf5; color: #065f46; }

/* ---------- checkbox / switch ---------- */
QCheckBox { spacing: 9px; color: #0f172a; font-weight: 700; font-size: 9.5pt; }
QCheckBox::indicator { width: 17px; height: 17px; border-radius: 5px; border: 1.5px solid #cbd5e1; background: #ffffff; }
QCheckBox::indicator:checked { background: #059669; border-color: #059669;
    image: none; /* tick drawn via border trick below */ }
QCheckBox::indicator:hover { border-color: #059669; }
QCheckBox[cssClass="switch"]::indicator {
    width: 38px; height: 21px; border: none; border-radius: 11px;
    image: url(:/resources/icons/switch-off.svg);
}
QCheckBox[cssClass="switch"]::indicator:checked { image: url(:/resources/icons/switch-on.svg); }
QRadioButton::indicator { width: 16px; height: 16px; border-radius: 8px; border: 1.5px solid #cbd5e1; background: #fff; }
QRadioButton::indicator:checked { border: 5px solid #059669; background: #ffffff; }

/* ---------- slider ---------- */
QSlider::groove:horizontal { height: 6px; border-radius: 3px; background: #e3e8ef; }
QSlider::sub-page:horizontal { background: #059669; border-radius: 3px; }
QSlider::handle:horizontal {
    width: 16px; height: 16px; margin: -5px 0;
    border-radius: 8px; background: #ffffff; border: 2px solid #059669;
}
QSlider::handle:horizontal:hover { background: #ecfdf5; }

/* ---------- tables ---------- */
QTableWidget, QTableView {
    background: #ffffff;
    alternate-background-color: #ffffff;
    border: 1px solid #e3e8ef;
    border-radius: 12px;
    gridline-color: transparent;
    selection-background-color: #ecfdf5;
    selection-color: #065f46;
    font-size: 9.8pt;
    outline: none;
}
QTableWidget::item, QTableView::item { padding: 12px 16px; border: none; }
QTableWidget::item:hover, QTableView::item:hover { background: #ecfdf5; color: #065f46; }
QTableWidget::item:selected, QTableView::item:selected { background: #ecfdf5; color: #065f46; }
QHeaderView::section {
    background: #f9fafb;
    color: #5b6779;
    padding: 11px 16px;
    border: none;
    border-bottom: 1px solid #e3e8ef;
    font-size: 7.5pt;
    font-weight: 800;
    letter-spacing: 1px;
}
QHeaderView::section:hover { color: #047857; }
QTableCornerButton::section { background: #f9fafb; border: none; }

/* ---------- lists / trees ---------- */
QListView { background: #ffffff; border: 1px solid #e3e8ef; border-radius: 10px; outline: none; }
QListView::item { padding: 8px 12px; border-radius: 7px; }
QListView::item:hover { background: #ecfdf5; color: #065f46; }
QListView::item:selected { background: #ecfdf5; color: #065f46; }
QTreeView { background: #ffffff; border: 1px solid #e3e8ef; outline: none; }
QTreeView::item:hover { background: #ecfdf5; }
QTreeView::item:selected { background: #ecfdf5; color: #065f46; }

/* ---------- menus ---------- */
QMenu {
    background: #ffffff;
    border: 1px solid #e3e8ef;
    border-radius: 12px;
    padding: 6px;
}
QMenu::item { padding: 9px 26px 9px 14px; border-radius: 8px; font-weight: 700; }
QMenu::item:selected { background: #ecfdf5; color: #065f46; }
QMenu::separator { height: 1px; background: #e3e8ef; margin: 4px 8px; }
QMenu::indicator { width: 14px; height: 14px; }

/* ---------- dialogs / modal cards ---------- */
QDialog[cssClass="modal"] { background: #ffffff; border: 1px solid #e3e8ef; border-radius: 14px; }
QFrame[cssClass="modalHead"] { background: #ffffff; border-bottom: 1px solid #e3e8ef; }
QFrame[cssClass="modalHead"] QLabel { font-family: "Space Grotesk"; font-size: 11.5pt; font-weight: 700; }
QFrame[cssClass="modalFoot"] { background: #f6f8fb; border-top: 1px solid #e3e8ef; }

/* ---------- banners ---------- */
QFrame[cssClass="bannerDanger"] {
    background: #fff1f3; border: 1px solid #fecdd3;
    border-left: 4px solid #e11d48; border-radius: 11px;
}
QFrame[cssClass="bannerDanger"] QLabel[cssClass="bannerTitle"] { color: #e11d48; font-weight: 700; }
QFrame[cssClass="bannerDanger"] QLabel[cssClass="bannerBody"]  { color: #5b6779; }
QFrame[cssClass="bannerGold"] {
    background: #fdf6e3; border: 1px solid #f0dfa8;
    border-left: 4px solid #c8941a; border-radius: 11px;
}

/* ---------- status bar ---------- */
QStatusBar { background: #f6f8fb; border-top: 1px solid #e3e8ef; color: #5b6779; font-size: 8.5pt; font-weight: 600; }
QStatusBar QLabel { color: #5b6779; font-size: 8.5pt; font-weight: 600; }
QStatusBar::item { border: none; }

/* ---------- scrollbars ---------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; border: none; }
QScrollBar::handle:vertical { background: #cbd5e1; border-radius: 5px; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: #059669; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; border: none; }
QScrollBar::handle:horizontal { background: #cbd5e1; border-radius: 5px; min-width: 32px; }
QScrollBar::handle:horizontal:hover { background: #059669; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
QListWidget#sidebarNav QScrollBar::handle:vertical { background: rgba(255,255,255,0.22); }
QListWidget#sidebarNav QScrollBar::handle:vertical:hover { background: rgba(255,255,255,0.4); }

/* ---------- tooltip ---------- */
QToolTip {
    background: #0e1f18;
    color: #e8f6ef;
    border: 1px solid #1d4636;
    border-left: 4px solid #059669;
    padding: 7px 11px;
    border-radius: 8px;
    font-size: 9pt;
    font-weight: 700;
    opacity: 245;
}

/* ---------- message boxes ---------- */
QMessageBox { background: #ffffff; }
QMessageBox QLabel { color: #0f172a; font-size: 10pt; }

/* ---------- group box / splitter ---------- */
QGroupBox {
    border: 1px solid #e3e8ef; border-radius: 12px;
    margin-top: 14px; padding-top: 16px;
    background: #ffffff;
}
QGroupBox::title { subcontrol-origin: margin; left: 14px; padding: 0 6px; color: #5b6779; font-weight: 800; font-size: 8.5pt; letter-spacing: 1px; }
QSplitter::handle { background: #e3e8ef; width: 1px; }

/* ---------- empty state (EmptyStateWidget) ---------- */
QFrame[cssClass="emptyState"] { background: transparent; }
QLabel[cssClass="emptyIcon"]    { font-size: 32pt; color: #8b96a8; background: transparent; }
QLabel[cssClass="emptyTitle"]   { font-size: 12pt; font-weight: 700; color: #5b6779; background: transparent; }
QLabel[cssClass="emptySubtitle"]{ font-size: 10pt; color: #8b96a8; font-style: italic; background: transparent; }

/* ---------- toast (widgets/Toast.h) ---------- */
QFrame#toast {
    background: #ffffff;
    border: 1px solid #e3e8ef;
    border-radius: 10px;
}
QFrame#toast[kind="ok"]   { border-left: 4px solid #059669; }
QFrame#toast[kind="err"]  { border-left: 4px solid #e11d48; }
QFrame#toast[kind="warn"] { border-left: 4px solid #d97706; }
QFrame#toast[kind="info"] { border-left: 4px solid #0891b2; }
QFrame#toast QLabel#toastMsg { color: #0f172a; font-size: 10pt; font-weight: 600; background: transparent; }

/* ---------- dashboard quick action buttons ---------- */
QPushButton[cssClass="qaBlue"], QPushButton[cssClass="qaPurple"],
QPushButton[cssClass="qaGreen"], QPushButton[cssClass="qaOrange"],
QPushButton[cssClass="qaIndigo"] {
    background: #ffffff;
    border: 1px solid #e3e8ef;
    border-radius: 11px;
    padding: 13px 15px;
    text-align: left;
    font-weight: 700;
    color: #0f172a;
}
QPushButton[cssClass="qaBlue"]:hover   { border-color: #bfdbfe; background: #f0f7ff; }
QPushButton[cssClass="qaPurple"]:hover { border-color: #ddd6fe; background: #f7f3ff; }
QPushButton[cssClass="qaGreen"]:hover  { border-color: #a7f3d0; background: #ecfdf5; }
QPushButton[cssClass="qaOrange"]:hover { border-color: #fde68a; background: #fffbeb; }
QPushButton[cssClass="qaIndigo"]:hover { border-color: #c7d2fe; background: #eef2ff; }

/* ---------- TEXT OVERFLOW & SIZING FIXES ---------- */
/* Prevent text bleeding in all labels */
QLabel { 
    background: transparent;
}
/* Stat card value — prevent overflow, allow shrink */
QLabel[cssClass="statValue"] { 
    font-family: "Space Grotesk"; font-size: 20pt; font-weight: 700; 
    color: #0f172a; background: transparent;
    max-height: 30px;
}
/* Stat card label — uppercase, small, no overflow */
QLabel[cssClass="statLabel"] { 
    font-size: 8pt; font-weight: 800; letter-spacing: 0.8px; 
    color: #5b6779; background: transparent;
    max-height: 16px;
}
/* Chart title — prevent overflow */
QLabel[cssClass="chartTitle"] { 
    font-weight: 700; font-size: 10pt; color: #0f172a; background: transparent;
    max-height: 20px;
}
QLabel[cssClass="chartSub"] { 
    color: #8b96a8; font-size: 8.5pt; font-weight: 600; background: transparent;
    max-height: 16px;
}
/* View subtitle */
QLabel[cssClass="viewSub"] { 
    font-size: 9pt; font-weight: 600; color: #5b6779; background: transparent;
}
/* H1 view title */
QLabel[cssClass="h1"] { 
    font-family: "Space Grotesk"; font-size: 15pt; font-weight: 700; 
    color: #0f172a; background: transparent;
}
/* Stat card — proper sizing */
QFrame#statCard {
    background: #ffffff; border: 1px solid #e3e8ef; border-radius: 12px;
    min-width: 180px; max-width: 300px;
    min-height: 110px; max-height: 140px;
}
/* Card — proper padding */
QFrame#card, QFrame[objectName="card"] {
    background: #ffffff; border: 1px solid #e3e8ef; border-radius: 12px;
    min-height: 200px;
}
/* QA buttons — proper sizing, prevent text overflow */
QPushButton[cssClass="qaBlue"], QPushButton[cssClass="qaPurple"],
QPushButton[cssClass="qaGreen"], QPushButton[cssClass="qaOrange"],
QPushButton[cssClass="qaIndigo"] {
    background: #ffffff; border: 1px solid #e3e8ef; border-radius: 11px;
    padding: 10px 12px; text-align: left; font-weight: 700; color: #0f172a;
    min-width: 150px; min-height: 56px; max-height: 70px;
}
/* Buttons — prevent text clipping */
QPushButton[cssClass="primary"] { min-height: 36px; }
QPushButton[cssClass="chip"] { min-height: 32px; min-width: 60px; }
QPushButton[cssClass="ghostDanger"] { min-height: 32px; min-width: 60px; }
/* Table — proper row height, prevent text clip */
QTableView, QTableWidget {
    min-height: 200px;
}
QTableView::item, QTableWidget::item { 
    padding: 8px 12px; border: none; min-height: 28px;
}
QHeaderView::section { 
    min-height: 32px; padding: 8px 12px;
}
/* Content area — match HTML #content padding */
QFrame#contentArea, QWidget#contentArea {
    background: #edf1f6;
}
/* Top bar — match HTML .topbar */
QFrame#topBar {
    background: #ffffff; border-bottom: 1px solid #e3e8ef;
    min-height: 54px; max-height: 58px;
}
/* Search box — match HTML .qwrap */
QLineEdit#searchBox {
    background: #f6f8fb; border: 1.5px solid #e3e8ef; border-radius: 10px;
    padding: 8px 12px; color: #0f172a; min-height: 36px; max-width: 330px;
    selection-background-color: #ecfdf5; selection-color: #065f46;
}
QLineEdit#searchBox:focus { 
    border: 2px solid #059669; padding: 7px 11px;
}
/* Crumb labels */
QLabel[cssClass="crumbSmall"] {
    font: 600 8.5pt Manrope; color: #8b96a8; letter-spacing: 0.5px;
    text-transform: uppercase; background: transparent;
}
QLabel[cssClass="crumbBig"] {
    font: 700 11.5pt "Space Grotesk"; color: #0f172a; background: transparent;
}
/* Session chip */
QFrame[cssClass="sessionChip"] {
    background: #f6f8fb; border: 1px solid #e3e8ef; border-radius: 99px;
    padding: 6px 12px;
}
QFrame[cssClass="sessionChip"] QLabel {
    color: #5b6779; font: 700 8.5pt "Space Grotesk"; background: transparent;
}
