* { font-family: "Inter", "Segoe UI", "Noto Sans", "Anek Malayalam", sans-serif; }
QMainWindow, QWidget { background-color: #0f172a; color: #e2e8f0; font-size: 10pt; }
QFrame#topBar { background-color: #1e293b; border-bottom: 1px solid #334155; }
QLineEdit#searchEdit { border: none; background: transparent; padding: 0 12px; font-size: 10pt; color: #e2e8f0; }
QFrame#sidebarWidget { background-color: #1e1b4b; }
QFrame#sidebarHeader { background-color: transparent; border: none; }
QLabel#sidebarAppName { display: none; }
QLabel#sidebarAppSub { display: none; }
QListWidget#sidebar { background-color: #1e1b4b; color: #c7d2fe; border: none; border-right: 1px solid #312e81; font-size: 9pt; font-weight: 500; outline: none; padding: 6px 0px; }
QListWidget#sidebar::item { padding: 10px 14px; border-left: 3px solid transparent; color: #c7d2fe; }
QListWidget#sidebar::item:selected { background-color: #3b82f6; color: #ffffff; border-left: 3px solid #60a5fa; font-weight: 600; }
QListWidget#sidebar::item:hover { background-color: rgba(255,255,255,0.10); color: #ffffff; }
QListWidget#sidebar QScrollBar:vertical { background: transparent; width: 0; height: 0; margin: 0; }
QFrame#sidebarUserCard { background-color: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; }
QLabel#sidebarUserInitial { background-color: #3b82f6; color: #ffffff; font-size: 14pt; font-weight: 700; border-radius: 20px; min-width: 40px; min-height: 40px; qproperty-alignment: AlignCenter; }
QLabel#sidebarUserName { color: #ffffff; font-size: 10pt; font-weight: 600; background: transparent; }
QLabel#sidebarUserRole { color: #93c5fd; font-size: 8pt; font-weight: 400; background: transparent; }
QPushButton#sidebarLogoutBtn { background-color: rgba(255,255,255,0.06); color: #ffffff; border: none; padding: 8px 12px; border-radius: 8px; font-weight: 600; min-height: 32px; }
QPushButton#sidebarLogoutBtn:hover { background-color: #ef4444; color: #ffffff; }
QToolButton#sidebarToggleFlap { background-color: #3b82f6; color: #ffffff; border: none; border-top-right-radius: 14px; border-bottom-right-radius: 14px; }
QToolButton#sidebarToggleFlap:hover { background-color: #2563eb; }
QMenuBar { background-color: #1e293b; color: #e2e8f0; border: none; }
QMenuBar::item { padding: 6px 12px; border-radius: 6px; }
QMenuBar::item:selected { background-color: #334155; }
QMenu { background-color: #1e293b; color: #e2e8f0; border: 1px solid #334155; border-radius: 10px; padding: 6px; }
QMenu::item { padding: 8px 28px; border-radius: 6px; }
QMenu::item:selected { background-color: #3b82f6; color: #ffffff; }
QPushButton { background-color: #334155; color: #e2e8f0; border: 1px solid #475569; padding: 8px 16px; border-radius: 8px; font-weight: 500; min-height: 20px; }
QPushButton:hover { background-color: #475569; border-color: #3b82f6; }
QPushButton:default, QPushButton#primaryButton { background-color: #3b82f6; color: #ffffff; border: none; font-weight: 600; }
QPushButton#action_add { background-color: #064e3b; color: #6ee7b7; border: 1px solid #065f46; font-weight: 600; }
QPushButton#action_edit { background-color: #1e3a8a; color: #93c5fd; border: 1px solid #1e40af; font-weight: 600; }
QPushButton#action_delete { background-color: #7f1d1d; color: #fca5a5; border: 1px solid #991b1b; font-weight: 600; }
QPushButton#action_save { background-color: #1e3a8a; color: #93c5fd; border: 1px solid #1e40af; font-weight: 600; }
QPushButton#action_print { background-color: #581c87; color: #d8b4fe; border: 1px solid #6b21a8; font-weight: 600; }
QPushButton#action_export { background-color: #164e63; color: #67e8f9; border: 1px solid #155e75; font-weight: 600; }
QPushButton#action_archive { background-color: #78350f; color: #fcd34d; border: 1px solid #92400e; font-weight: 600; }
QPushButton#action_approve { background-color: #064e3b; color: #6ee7b7; border: 1px solid #065f46; font-weight: 600; }
QPushButton#action_reject { background-color: #7f1d1d; color: #fca5a5; border: 1px solid #991b1b; font-weight: 600; }
QPushButton#action_disburse { background-color: #78350f; color: #fcd34d; border: 1px solid #92400e; font-weight: 600; }
QPushButton#action_refresh { background-color: #334155; color: #60a5fa; border: 1px solid #3b82f6; font-weight: 600; }
QPushButton#action_generate { background-color: #581c87; color: #d8b4fe; border: 1px solid #6b21a8; font-weight: 600; }
QPushButton#action_reset { background-color: #78350f; color: #fcd34d; border: 1px solid #92400e; font-weight: 600; }
QPushButton#action_unlock { background-color: #164e63; color: #67e8f9; border: 1px solid #155e75; font-weight: 600; }
QPushButton#action_restore { background-color: #164e63; color: #67e8f9; border: 1px solid #155e75; font-weight: 600; }
QPushButton#action_upload { background-color: #1e3a8a; color: #93c5fd; border: 1px solid #1e40af; font-weight: 600; }
QPushButton#action_prev, QPushButton#action_next { min-width: 90px; }
QPushButton#dash_qa_blue { background-color: #1e3a8a; color: #93c5fd; border: 1px solid #1e40af; font-weight: 600; }
QPushButton#dash_qa_purple { background-color: #581c87; color: #d8b4fe; border: 1px solid #6b21a8; font-weight: 600; }
QPushButton#dash_qa_green { background-color: #064e3b; color: #6ee7b7; border: 1px solid #065f46; font-weight: 600; }
QPushButton#dash_qa_orange { background-color: #78350f; color: #fcd34d; border: 1px solid #92400e; font-weight: 600; }
QPushButton#dash_qa_indigo { background-color: #312e81; color: #a5b4fc; border: 1px solid #3730a3; font-weight: 600; }
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit { background-color: #1e293b; color: #e2e8f0; border: 1px solid #475569; padding: 8px 14px; border-radius: 8px; }
QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus, QDateEdit:focus { border: 2px solid #3b82f6; padding: 7px 13px; }
QComboBox { padding: 8px 36px 8px 14px; border: 1px solid #475569; border-radius: 8px; background-color: #1e293b; color: #e2e8f0; font-weight: 500; }
QComboBox::drop-down { width: 28px; border-left: 1px solid #334155; border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
QComboBox::down-arrow { image: url(:/icons/chevron-down.svg); width: 16px; height: 16px; margin-right: 8px; }
QComboBox QAbstractItemView { background-color: #1e293b; color: #e2e8f0; border: 1px solid #334155; border-radius: 8px; selection-background-color: #3b82f6; selection-color: #ffffff; outline: 0; padding: 4px; margin-top: 6px; }
QComboBox QAbstractItemView::item { padding: 8px 14px; min-height: 24px; border-radius: 6px; margin: 1px 0; font-weight: 500; border: none; }
QComboBox QAbstractItemView::item:hover { background-color: #334155; color: #93c5fd; border: none; }
QComboBox QAbstractItemView::item:selected { background-color: #3b82f6; color: #ffffff; font-weight: 600; }
QTableView, QTreeView, QListView { background-color: #1e293b; alternate-background-color: #334155; color: #e2e8f0; gridline-color: #334155; selection-background-color: #3b82f6; selection-color: #ffffff; border: 1px solid #334155; border-radius: 12px; outline: 0; }
QHeaderView::section { background-color: #0f172a; color: #94a3b8; padding: 10px 8px; border: none; font-weight: 600; }
QTabWidget::pane { border: 1px solid #334155; border-radius: 12px; background: #1e293b; margin-top: -1px; }
QTabBar::tab { background: transparent; color: #94a3b8; padding: 10px 20px; border-radius: 8px; font-weight: 500; }
QTabBar::tab:selected { background: #1e293b; color: #3b82f6; }
QTabBar::tab:hover { color: #60a5fa; }
QLabel { color: #e2e8f0; background: transparent; }
QGroupBox { color: #94a3b8; border: 1px solid #334155; border-radius: 12px; margin-top: 16px; padding-top: 16px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 16px; padding: 0 8px; }
QScrollBar:vertical { background: transparent; width: 8px; border: none; }
QScrollBar::handle:vertical { background: #475569; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #3b82f6; }
QScrollBar:horizontal { background: transparent; height: 8px; border: none; }
QScrollBar::handle:horizontal { background: #475569; border-radius: 4px; min-width: 30px; }
QStatusBar { background-color: #1e293b; color: #94a3b8; border-top: 1px solid #334155; }
QToolButton { background: transparent; color: #e2e8f0; border: none; padding: 8px 12px; border-radius: 8px; }
QToolButton:hover { background-color: #334155; color: #60a5fa; }
QToolTip { background-color: #1e293b; color: #ffffff; border: 1px solid #3b82f6; border-radius: 6px; padding: 8px 12px; font-size: 10pt; font-weight: 500; min-width: 60px; }
QCheckBox { color: #e2e8f0; background: transparent; spacing: 8px; }
QCheckBox::indicator { width: 18px; height: 18px; border: 1px solid #475569; background-color: #1e293b; border-radius: 4px; }
QCheckBox::indicator:checked { background-color: #3b82f6; border-color: #3b82f6; }
QFrame#card { background-color: #1e293b; border: 1px solid #334155; border-radius: 12px; }
QFrame#statCard { background-color: #1e293b; border: 1px solid #334155; border-radius: 12px; }
QLabel#statCardTitle { font-size: 9pt; font-weight: 500; color: #94a3b8; background: transparent; }
QLabel#statCardValue { font-size: 24pt; font-weight: 700; color: #f1f5f9; background: transparent; }
QLabel#statCardSub { font-size: 8pt; font-weight: 400; color: #64748b; background: transparent; }
QLabel#chartCardTitle { font-size: 12pt; font-weight: 700; color: #f1f5f9; background: transparent; }
QLabel#dashTitle { font-size: 18pt; font-weight: 700; color: #f1f5f9; background: transparent; }
QLabel#dashWelcome { font-size: 10pt; font-weight: 400; color: #94a3b8; background: transparent; }
QLabel#viewTitle { font-size: 18pt; font-weight: 700; color: #f1f5f9; background: transparent; padding: 4px 0 8px 0; }
QPushButton:disabled { background-color: #1e293b; color: #475569; border-color: #334155; }
QMessageBox, QDialog { background-color: #0f172a; }
QFrame#loginCard { background-color: #1e293b; border: 1px solid #334155; border-radius: 16px; }
QLabel#appName { color: #60a5fa; font-size: 18pt; font-weight: 700; }
QLabel#appSub { color: #94a3b8; font-size: 10pt; }
QLabel#errorLabel { color: #f87171; font-weight: 600; }
QLabel#hintLabel { color: #64748b; font-size: 9pt; }
