/* ================================================================
   MMS · Emerald Flat theme — LIGHT
   Fonts: Poppins (English) + Gayathri (Malayalam)
   Buttons: squircle, no border, pastel colors
   Sidebar: Islamic star pattern overlay
   ================================================================ */

/* ---------- base ---------- */
QWidget {
    font-family: "Poppins";
    font-size: 10pt;
    color: #e6f2ea;
}
QMainWindow, QDialog { background: #0a1a12; }
QFrame#contentArea, QWidget#contentArea { background: #0a1a12; }

/* ---------- typography roles ---------- */
QLabel[cssClass="display"]   { font-family: "Space Grotesk"; font-weight: 700; }
QLabel[cssClass="h1"]        { font-family: "Space Grotesk"; font-size: 15pt; font-weight: 700; color: #e6f2ea; }
QLabel[cssClass="h2"]        { font-family: "Space Grotesk"; font-size: 12pt; font-weight: 700; color: #e6f2ea; }
QLabel[cssClass="statValue"] { font-family: "Space Grotesk"; font-size: 18pt; font-weight: 700; color: #77ecbb; max-height: 30px; background: transparent; }
QLabel[cssClass="statLabel"] { font-size: 8pt; font-weight: 800; letter-spacing: 1px; color: #77ecbb; max-height: 16px; background: transparent; }
QLabel[cssClass="viewSub"]   { font-size: 9pt; font-weight: 600; color: #9fb8aa; background: transparent; }
QLabel[cssClass="muted"]     { color: #9fb8aa; }
QLabel[cssClass="faint"]     { color: #6d8878; }
QLabel[cssClass="emerald"]   { color: #047857; font-weight: 700; }
QLabel[cssClass="sectionTitle"] { font-size: 8pt; font-weight: 800; letter-spacing: 2px; color: #6d8878; }
QLabel[cssClass="ml"]        { font-family: "Gayathri"; }
QLabel[cssClass="crumbSmall"] { font: 700 8.5pt Poppins; color: #6d8878; letter-spacing: 0.5px; text-transform: uppercase; }
QLabel[cssClass="crumbBig"]   { font: 700 11.5pt "Space Grotesk"; color: #e6f2ea; }

/* ---------- sidebar with Islamic star pattern ---------- */
QFrame#sidebar, QWidget#sidebar {
    background-color: #0aa06f;
    background-image: url(:/resources/icons/pattern-star.svg);
    background-repeat: repeat-xy;
    background-position: top left;
}
QLabel[cssClass="logoTitle"] { color: #13221a; font-family: "Space Grotesk"; font-size: 13pt; font-weight: 800; }
QLabel[cssClass="logoSub"]   { color: #a5dcc6; font-size: 8pt; font-weight: 600; letter-spacing: 1px; }
QLabel[cssClass="navSection"]{ color: rgba(214,240,228,0.42); font-size: 7pt; font-weight: 800; letter-spacing: 2px; padding: 15px 24px 5px; }
QListWidget#sidebarNav { background: transparent; border: none; outline: none; }
QListWidget#sidebarNav::item {
    color: #c4e7d7; padding: 11px 13px; margin: 2px 10px; border-radius: 9px;
    border-left: 4px solid transparent; font-weight: 700; font-size: 9.8pt;
}
QListWidget#sidebarNav::item:hover { background: rgba(255,255,255,0.09); color: #13221a; }
QListWidget#sidebarNav::item:selected {
    background: rgba(255,255,255,0.14); color: #13221a;
    border-left: 4px solid #f2c14e;
}
QFrame#userCard { background: transparent; border-top: 1px solid rgba(255,255,255,0.14); }
QFrame#userCard QLabel[cssClass="userName"] { color: #13221a; font-weight: 700; font-size: 9.5pt; }
QFrame#userCard QLabel[cssClass="userRole"] { color: #9fd8c3; font-size: 8pt; font-weight: 600; }
QLabel[cssClass="avatar"] {
    background: #f2c14e; color: #4a3606; border-radius: 9px;
    border: 2px solid #b98317;
    font-family: "Space Grotesk"; font-weight: 800; font-size: 10pt;
    qproperty-alignment: AlignCenter;
}
QToolButton#flap, QPushButton[cssClass="flap"] {
    background: #047857; border: 1px solid #0a7f5d; border-radius: 9px;
    color: #13221a; padding: 0px; margin: 0px;
}
QToolButton#flap:hover, QPushButton[cssClass="flap"]:hover { background: #0aa06f; color: #13221a; }

/* ---------- top bar ---------- */
QFrame#topBar { background: #13221a; border-bottom: 1.5px solid #23402f; min-height: 54px; max-height: 58px; }
QLineEdit#searchBox {
    background: #0f1c15; border: 1.5px solid #23402f; border-radius: 9px;
    padding: 8px 12px; color: #e6f2ea; min-height: 36px; max-width: 330px;
    selection-background-color: #0c3527; selection-color: #0aa06f;
}
QLineEdit#searchBox:focus { border: 2px solid #059669; padding: 7px 11px; }

/* ---------- cards ---------- */
QFrame[cssClass="card"], QFrame#card, QFrame[objectName="card"] {
    background: #13221a; border: 1.5px solid #23402f; border-radius: 10px;
}
QFrame#statCard {
    border-radius: 10px; min-width: 180px; max-width: 300px;
    min-height: 110px; max-height: 140px;
}
QLabel[cssClass="chartTitle"] { font-weight: 700; font-size: 10pt; color: #e6f2ea; max-height: 20px; background: transparent; }
QLabel[cssClass="chartSub"]   { color: #6d8878; font-size: 8.5pt; font-weight: 600; max-height: 16px; background: transparent; }

/* ---------- buttons: SQUIRCLE, NO BORDER, pastel colors ---------- */
QPushButton {
    background: #0a2f22; border: none; border-radius: 12px;
    padding: 9px 18px; color: #77ecbb; font-weight: 700; font-size: 9.8pt;
    min-height: 36px; min-width: 80px;
}
QPushButton:hover   { background: #0a2f22; }
QPushButton:pressed { background: #14532d; }
QPushButton:disabled { background: #0f1c15; color: #6d8878; }

QPushButton[cssClass="primary"] {
    background: #0a2f22; border: none; border-radius: 12px; color: #77ecbb;
}
QPushButton[cssClass="primary"]:hover   { background: #14532d; }
QPushButton[cssClass="primary"]:pressed { background: #0aa06f; }
QPushButton[cssClass="primary"]:disabled { background: #0f1c15; color: #6d8878; }

QPushButton[cssClass="danger"] {
    background: #3c0d18; border: none; border-radius: 12px; color: #fba8ba;
}
QPushButton[cssClass="danger"]:hover { background: #6b1230; }

QPushButton[cssClass="ghostDanger"] {
    background: #3c0d18; border: none; border-radius: 12px; color: #fba8ba;
}
QPushButton[cssClass="ghostDanger"]:hover { background: #6b1230; }

QPushButton[cssClass="small"] { padding: 5px 12px; font-size: 8.8pt; border-radius: 10px; min-height: 28px; }

QPushButton[cssClass="icon"] {
    background: transparent; border: none; border-radius: 10px;
    padding: 6px; color: #9fb8aa;
}
QPushButton[cssClass="icon"]:hover { background: #0a2f22; color: #047857; }

QPushButton[cssClass="chip"] {
    border-radius: 99px; padding: 7px 16px; border: none;
    background: #1c2739; color: #c0cde0; font-weight: 700; font-size: 9pt; min-height: 32px;
}
QPushButton[cssClass="chip"]:hover { background: #1c2739; }
QPushButton[cssClass="chip"]:checked { background: #059669; color: #13221a; }

/* QA buttons: pastel backgrounds, squircle, no border */
QPushButton[cssClass="qaBlue"]   { background: #13234d; border: none; border-radius: 12px; color: #9dbcfa; }
QPushButton[cssClass="qaPurple"] { background: #241343; border: none; border-radius: 12px; color: #c3a9f8; }
QPushButton[cssClass="qaGreen"]  { background: #0a2f22; border: none; border-radius: 12px; color: #77ecbb; }
QPushButton[cssClass="qaOrange"] { background: #39230a; border: none; border-radius: 12px; color: #f7cf8e; }
QPushButton[cssClass="qaIndigo"] { background: #13234d; border: none; border-radius: 12px; color: #9dbcfa; }
QPushButton[cssClass="qaBlue"]:hover   { background: #13234d; }
QPushButton[cssClass="qaPurple"]:hover { background: #241343; }
QPushButton[cssClass="qaGreen"]:hover  { background: #07302c; }
QPushButton[cssClass="qaOrange"]:hover { background: #39230a; }
QPushButton[cssClass="qaIndigo"]:hover { background: #13234d; }

/* ---------- status pills ---------- */
QLabel[cssClass="pill"] {
    padding: 3px 10px; border-radius: 99px;
    font-size: 8pt; font-weight: 800; letter-spacing: 0.5px;
    qproperty-alignment: AlignCenter;
}
QLabel[status="Paid"], QLabel[status="Active"], QLabel[status="Collected"],
QLabel[status="Disbursed"], QLabel[status="Income"], QLabel[status="Administrator"] {
    background: #0a2f22; color: #77ecbb; border: 1.5px solid #059669;
}
QLabel[status="Pending"], QLabel[status="Requested"], QLabel[status="Assigned"] {
    background: #39230a; color: #f7cf8e; border: 1.5px solid #e59b25;
}
QLabel[status="Overdue"], QLabel[status="Revoked"], QLabel[status="Expense"] {
    background: #3c0d18; color: #fba8ba; border: 1.5px solid #ef4d70;
}
QLabel[status="Approved"], QLabel[status="Manager"], QLabel[status="Manual"] {
    background: #08313c; color: #7fdcf0; border: 1.5px solid #1ba3c6;
}
QLabel[status="Available"], QLabel[status="Archived"], QLabel[status="Disabled"],
QLabel[status="User"], QLabel[status="Auto"] {
    background: #1c2739; color: #c0cde0; border: 1.5px solid #7d8ea8;
}

/* ---------- inputs ---------- */
QLineEdit, QSpinBox, QDateEdit, QTimeEdit, QPlainTextEdit, QTextEdit {
    background: #13221a; border: 1.5px solid #335944; border-radius: 8px;
    padding: 9px 12px; color: #e6f2ea; selection-background-color: #0c3527; selection-color: #0aa06f;
}
QLineEdit:focus, QSpinBox:focus, QDateEdit:focus, QTimeEdit:focus { border: 2px solid #059669; padding: 8px 11px; }
QLabel[cssClass="fieldLabel"] { color: #9fb8aa; font-size: 8pt; font-weight: 800; letter-spacing: 1px; }

QComboBox {
    background: #13221a; border: 1.5px solid #335944; border-radius: 8px;
    padding: 9px 12px; color: #e6f2ea; font-weight: 600;
}
QComboBox:focus, QComboBox:on { border: 2px solid #059669; padding: 8px 11px; }
QComboBox::drop-down { border: none; width: 30px; margin: 0; }
QComboBox::down-arrow { image: url(:/resources/icons/chevron-down.svg); width: 12px; height: 12px; margin-right: 10px; }
QComboBox QAbstractItemView {
    background: #13221a; border: 1.5px solid #23402f; border-radius: 10px;
    margin: 0; padding: 4px; outline: none;
    selection-background-color: #0a2f22; selection-color: #0aa06f;
}
QComboBox QAbstractItemView::item { padding: 8px 12px; min-height: 30px; border-radius: 7px; }
QComboBox QAbstractItemView::item:hover { background: #0a2f22; color: #047857; }
QComboBox QAbstractItemView::item:selected { background: #0a2f22; color: #0aa06f; }

QCheckBox { spacing: 9px; color: #e6f2ea; font-weight: 700; font-size: 9.5pt; }
QCheckBox::indicator { width: 17px; height: 17px; border-radius: 5px; border: 1.5px solid #335944; background: #13221a; }
QCheckBox::indicator:checked { background: #059669; border-color: #059669; }

/* ---------- tables ---------- */
QTableWidget, QTableView {
    background: #13221a; alternate-background-color: #13221a;
    border: 1.5px solid #23402f; border-radius: 10px; gridline-color: transparent;
    selection-background-color: #0c3527; selection-color: #0aa06f; font-size: 9.8pt; outline: none;
}
QTableWidget::item, QTableView::item { padding: 8px 12px; border: none; min-height: 28px; }
QHeaderView::section {
    background: #1b2f23; color: #9fb8aa; padding: 8px 12px;
    border: none; border-bottom: 2px solid #23402f;
    font-size: 7.5pt; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; min-height: 32px;
}
QHeaderView::section:hover { color: #047857; }
QTableCornerButton::section { background: #1b2f23; border: none; }

/* ---------- menus ---------- */
QMenu { background: #13221a; border: 1.5px solid #23402f; border-radius: 11px; padding: 6px; }
QMenu::item { padding: 9px 26px 9px 14px; border-radius: 8px; font-weight: 700; }
QMenu::item:selected { background: #0a2f22; color: #0aa06f; }
QMenu::separator { height: 1.5px; background: #23402f; margin: 4px 8px; }

/* ---------- scrollbars ---------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; border: none; }
QScrollBar::handle:vertical { background: #335944; border-radius: 5px; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: #059669; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; border: none; }
QScrollBar::handle:horizontal { background: #335944; border-radius: 5px; min-width: 32px; }
QScrollBar::handle:horizontal:hover { background: #059669; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
QListWidget#sidebarNav QScrollBar::handle:vertical { background: rgba(255,255,255,0.22); }
QListWidget#sidebarNav QScrollBar::handle:vertical:hover { background: rgba(255,255,255,0.4); }

/* ---------- tooltip ---------- */
QToolTip {
    background: #0a1a12; color: #e8f6ef; border: 1px solid #23402f;
    border-left: 4px solid #059669; padding: 7px 11px; border-radius: 8px;
    font-size: 9pt; font-weight: 700;
}

/* ---------- empty state ---------- */
QFrame[cssClass="emptyState"] { background: transparent; }
QLabel[cssClass="emptyIcon"]    { font-size: 32pt; color: #6d8878; background: transparent; }
QLabel[cssClass="emptyTitle"]   { font-size: 12pt; font-weight: 700; color: #9fb8aa; background: transparent; }
QLabel[cssClass="emptySubtitle"]{ font-size: 10pt; color: #6d8878; font-style: italic; background: transparent; }

/* ---------- toast ---------- */
QFrame#toast { background: #13221a; border: 1px solid #23402f; border-radius: 10px; }
QFrame#toast[kind="ok"]   { border-left: 4px solid #059669; }
QFrame#toast[kind="err"]  { border-left: 4px solid #ef4d70; }
QFrame#toast[kind="warn"] { border-left: 4px solid #e59b25; }
QFrame#toast[kind="info"] { border-left: 4px solid #1ba3c6; }
QFrame#toast QLabel#toastMsg { color: #e6f2ea; font-size: 10pt; font-weight: 600; background: transparent; }

/* ---------- progress ---------- */
QProgressBar { background: #0f1c15; border: 1.5px solid #23402f; border-radius: 6px; max-height: 10px; min-height: 10px; text-align: center; color: transparent; }
QProgressBar::chunk { background: #059669; border-radius: 5px; }

/* ---------- status bar ---------- */
QStatusBar { background: #0f1c15; border-top: 1.5px solid #23402f; color: #9fb8aa; font-size: 8.5pt; font-weight: 600; }
QStatusBar QLabel { color: #9fb8aa; font-size: 8.5pt; font-weight: 600; }
QStatusBar::item { border: none; }

/* ---------- group box ---------- */
QGroupBox { border: 1.5px solid #23402f; border-radius: 10px; margin-top: 14px; padding-top: 16px; background: #13221a; }
QGroupBox::title { subcontrol-origin: margin; left: 14px; padding: 0 6px; color: #9fb8aa; font-weight: 800; font-size: 8.5pt; }

/* ---------- message boxes ---------- */
QMessageBox { background: #13221a; }
QMessageBox QLabel { color: #e6f2ea; font-size: 10pt; }

/* ---------- delta badges (stat card) ---------- */
QLabel[cssClass="deltaUp"], QLabel[cssClass="deltaDown"] {
    font: 800 9.5px Poppins; padding: 3px 8px; border-radius: 99px;
    background: #13221a; max-width: 140px;
}
QLabel[cssClass="deltaUp"]   { color: #047857; border: 1.5px solid #059669; }
QLabel[cssClass="deltaDown"] { color: #fba8ba; border: 1.5px solid #ef4d70; }

/* ---------- stat card tint variants ---------- */
QFrame[cssClass="statTint-em"]     { background: #0a2f22; border: 1.5px solid #059669; border-radius: 10px; }
QFrame[cssClass="statTint-teal"]   { background: #07302c; border: 1.5px solid #12a594; border-radius: 10px; }
QFrame[cssClass="statTint-sky"]    { background: #0a2c42; border: 1.5px solid #2f9bdd; border-radius: 10px; }
QFrame[cssClass="statTint-gold"]   { background: #39230a; border: 1.5px solid #e59b25; border-radius: 10px; }
QFrame[cssClass="statTint-rose"]   { background: #3c0d18; border: 1.5px solid #ef4d70; border-radius: 10px; }
QFrame[cssClass="statTint-pink"]   { background: #3d1027; border: 1.5px solid #e44a90; border-radius: 10px; }
QFrame[cssClass="statTint-violet"] { background: #241343; border: 1.5px solid #9161ee; border-radius: 10px; }
QFrame[cssClass="statTint-orange"] { background: #3a1808; border: 1.5px solid #f0762f; border-radius: 10px; }
QFrame[cssClass="statTint-slate"]  { background: #1c2739; border: 1.5px solid #7d8ea8; border-radius: 10px; }
QFrame[cssClass="statTint-blue"]   { background: #13234d; border: 1.5px solid #2563eb; border-radius: 10px; }

/* stat card value/label per tint */
QLabel[cssClass="statVal-em"]     { font: 700 18pt "Space Grotesk"; color: #77ecbb; background: transparent; max-height: 30px; }
QLabel[cssClass="statVal-teal"]   { font: 700 18pt "Space Grotesk"; color: #6fe3d4; background: transparent; max-height: 30px; }
QLabel[cssClass="statVal-sky"]    { font: 700 18pt "Space Grotesk"; color: #85cdf6; background: transparent; max-height: 30px; }
QLabel[cssClass="statVal-gold"]   { font: 700 18pt "Space Grotesk"; color: #f7cf8e; background: transparent; max-height: 30px; }
QLabel[cssClass="statVal-rose"]   { font: 700 18pt "Space Grotesk"; color: #fba8ba; background: transparent; max-height: 30px; }
QLabel[cssClass="statVal-pink"]   { font: 700 18pt "Space Grotesk"; color: #f5a3c8; background: transparent; max-height: 30px; }
QLabel[cssClass="statVal-violet"] { font: 700 18pt "Space Grotesk"; color: #c3a9f8; background: transparent; max-height: 30px; }
QLabel[cssClass="statVal-orange"] { font: 700 18pt "Space Grotesk"; color: #f8b58b; background: transparent; max-height: 30px; }
QLabel[cssClass="statVal-slate"]  { font: 700 18pt "Space Grotesk"; color: #c0cde0; background: transparent; max-height: 30px; }
QLabel[cssClass="statVal-blue"]   { font: 700 18pt "Space Grotesk"; color: #9dbcfa; background: transparent; max-height: 30px; }

QLabel[cssClass="statLab-em"]     { font: 800 8pt Poppins; letter-spacing: 1px; color: #77ecbb; background: transparent; max-height: 16px; }
QLabel[cssClass="statLab-teal"]   { font: 800 8pt Poppins; letter-spacing: 1px; color: #6fe3d4; background: transparent; max-height: 16px; }
QLabel[cssClass="statLab-sky"]    { font: 800 8pt Poppins; letter-spacing: 1px; color: #85cdf6; background: transparent; max-height: 16px; }
QLabel[cssClass="statLab-gold"]   { font: 800 8pt Poppins; letter-spacing: 1px; color: #f7cf8e; background: transparent; max-height: 16px; }
QLabel[cssClass="statLab-rose"]   { font: 800 8pt Poppins; letter-spacing: 1px; color: #fba8ba; background: transparent; max-height: 16px; }
QLabel[cssClass="statLab-pink"]   { font: 800 8pt Poppins; letter-spacing: 1px; color: #f5a3c8; background: transparent; max-height: 16px; }
QLabel[cssClass="statLab-violet"] { font: 800 8pt Poppins; letter-spacing: 1px; color: #c3a9f8; background: transparent; max-height: 16px; }
QLabel[cssClass="statLab-orange"] { font: 800 8pt Poppins; letter-spacing: 1px; color: #f8b58b; background: transparent; max-height: 16px; }
QLabel[cssClass="statLab-slate"]  { font: 800 8pt Poppins; letter-spacing: 1px; color: #c0cde0; background: transparent; max-height: 16px; }
QLabel[cssClass="statLab-blue"]   { font: 800 8pt Poppins; letter-spacing: 1px; color: #9dbcfa; background: transparent; max-height: 16px; }

/* chart title with colored left border */
QLabel[cssClass="chartTitle-em"]     { font: 700 10pt Poppins; color: #e6f2ea; background: transparent; padding-left: 10px; border-left: 5px solid #059669; max-height: 20px; }
QLabel[cssClass="chartTitle-gold"]   { font: 700 10pt Poppins; color: #e6f2ea; background: transparent; padding-left: 10px; border-left: 5px solid #e59b25; max-height: 20px; }
QLabel[cssClass="chartTitle-violet"] { font: 700 10pt Poppins; color: #e6f2ea; background: transparent; padding-left: 10px; border-left: 5px solid #9161ee; max-height: 20px; }
QLabel[cssClass="chartTitle-sky"]    { font: 700 10pt Poppins; color: #e6f2ea; background: transparent; padding-left: 10px; border-left: 5px solid #2f9bdd; max-height: 20px; }

/* QA button text labels */
QLabel[cssClass="qaTitle"] { font: 700 11px Poppins; color: #e6f2ea; background: transparent; border: none; max-height: 16px; }
QLabel[cssClass="qaSub"]   { font: 600 9px Poppins; color: #6d8878; background: transparent; border: none; max-height: 14px; }

/* date chip */
QLabel[cssClass="dateChip"] { font: 700 9pt Poppins; color: #c0cde0; background: #1c2739; border: 1.5px solid #7d8ea8; border-radius: 7px; padding: 7px 12px; }
