        <file alias="welfare.svg">icons/svg/welfare.svg</file>
        <file alias="certificates.svg">icons/svg/certificates.svg</file>
        <file alias="reports.svg">icons/svg/reports.svg</file>
        <file alias="settings.svg">icons/svg/settings.svg</file>
