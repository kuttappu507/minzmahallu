        <file alias="Poppins-Medium.ttf">fonts/Poppins-Medium.ttf</file>
        <file alias="Poppins-SemiBold.ttf">fonts/Poppins-SemiBold.ttf</file>
        <file alias="Poppins-Bold.ttf">fonts/Poppins-Bold.ttf</file>
        <file alias="Gayathri-Regular.ttf">fonts/Gayathri-Regular.ttf</file>
        <file alias="Gayathri-Bold.ttf">fonts/Gayathri-Bold.ttf</file>
    </qresource>
